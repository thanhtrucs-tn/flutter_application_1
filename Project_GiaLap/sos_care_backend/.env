# Server configuration
PORT=8080
NODE_ENV=development

# MySQL database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=project_app
DB_USER=root
DB_PASS=

# JWT configuration
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
# Set to false to skip file log transport and reduce disk I/O during dev restarts
LOG_TO_FILE=true

# Database schema sync (development only). Set to true to run Sequelize alter sync on startup.
# Default false for faster simulation restarts.
DB_SYNC=false

# CORS origin for Express and Socket.IO
# Use comma-separated origins or * for all (dev only)
CORS_ORIGIN=*

# Device authentication mode for POST endpoints
# none = public in local dev, token = require X-Device-Token header matching DEVICE_TOKEN
DEVICE_AUTH_MODE=none

# Shared device token required when DEVICE_AUTH_MODE=token
DEVICE_TOKEN=shared-device-token-change-in-production
